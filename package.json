{
    "name": "st-regex-perf",
    "private": true,
    "type": "module",
    "description": "Development tooling for the Regex Perf Kit SillyTavern extension (not needed to use the extension).",
    "scripts": {
        "lint": "eslint .",
        "fetch-st": "node tests/fetch-st.mjs",
        "test:eslint-sync": "node tests/eslint-sync.mjs",
        "test:fuzz": "node tests/needle-fuzz.mjs",
        "test:browser": "node tests/run.mjs",
        "test": "npm run lint && npm run test:eslint-sync && npm run test:fuzz && npm run test:browser",
        "bench": "node tests/bench.mjs",
        "screenshots": "node tests/screenshots.mjs"
    },
    "devDependencies": {
        "eslint": "^8.57.1",
        "eslint-plugin-jsdoc": "^48.10.0",
        "jquery": "^3.7.1",
        "puppeteer-core": "^24.0.0"
    },
    "engines": {
        "node": ">=22"
    }
}
